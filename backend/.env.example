# App
NODE_ENV=local
PORT=3000
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Base URL of the web app, used to build tappable links in outbound webhook messages.
APP_BASE_URL=http://localhost:3001

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Realtime editing (collab service)
# HTTP base URL of the Hocuspocus/Yjs collab server. Doc page bodies are co-edited
# there, so a body written outside the editor (MCP `update_doc`) has to ask that
# server to re-read it — otherwise an open editor mirrors its stale copy back over
# the write. The API authenticates with an ordinary access token, so no extra
# secret: the collab server's JWT_SECRET is already the same value as above.
# Leave unset if this deployment does not run the collab service — writes then
# simply skip the refresh.
COLLAB_HTTP_URL=http://localhost:3002

# MongoDB
MONGODB_URI=mongodb://producthub:producthub@localhost:27017/producthub?authSource=admin
